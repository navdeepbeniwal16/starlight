# Public API base URL (EXPO_PUBLIC_* is inlined into the client bundle at build time)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Clerk publishable key for the dev instance (safe to expose in the client).
# Get it from the Clerk Dashboard → API Keys. The secret key stays server-side.
# Production builds inject the pk_live_ key from the EAS `production` environment,
# not this file — see docs/runbooks/clerk-production-cutover.md.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
