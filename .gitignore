.claude/scheduled_tasks.lock

# Skills discovery dir: ignore by default (stray global-install symlinks land here)
.claude/skills/*

# Starlight-specific skills — un-ignore each one explicitly, e.g.:
# !.claude/skills/my-starlight-skill/

